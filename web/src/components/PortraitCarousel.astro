---
import type { PortraitSlide } from "../lib/lore";

interface Props {
  slides: PortraitSlide[];
  title: string;
}

const { slides, title } = Astro.props;
const first = slides[0];
---

{
  first && (
    <div class="portrait-carousel w-full max-w-[20rem]" data-carousel>
      <script type="application/json" set:html={JSON.stringify(slides)} />
      <img
        src={first.url}
        alt={`${title} — ${first.label}`}
        class="h-auto w-full max-h-[36rem] rounded-2xl border border-line object-contain bg-ink"
        data-frame
      />
      <p class="mt-2 text-sm text-mist" data-label>{first.label}</p>
      {slides.length > 1 && (
        <div class="mt-3 flex items-center gap-2">
          <button
            type="button"
            class="rounded-lg border border-line px-3 py-1 text-sm text-mist hover:border-gold/50 hover:text-gold"
            data-prev
            aria-label="Предыдущий образ"
          >
            ←
          </button>
          <span class="min-w-12 text-center text-xs text-dim" data-count>1 / {slides.length}</span>
          <button
            type="button"
            class="rounded-lg border border-line px-3 py-1 text-sm text-mist hover:border-gold/50 hover:text-gold"
            data-next
            aria-label="Следующий образ"
          >
            →
          </button>
        </div>
      )}
      {slides.length > 1 && (
        <div class="mt-2 flex flex-wrap gap-1" data-dots>
          {slides.map((slide, index) => (
            <button
              type="button"
              class:list={[
                "h-2.5 w-2.5 rounded-full border border-gold/40",
                index === 0 ? "bg-gold" : "bg-transparent",
              ]}
              data-dot={index}
              aria-label={slide.label}
            />
          ))}
        </div>
      )}
    </div>
  )
}

<script>
  function bindCarousels() {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
      if (root.dataset.bound === "1") return;
      const json = root.querySelector("script[type='application/json']");
      if (!json) return;
      const slides = JSON.parse(json.textContent || "[]") as { url: string; label: string }[];
      if (slides.length < 2) return;
      root.dataset.bound = "1";
      let index = 0;
      const frame = root.querySelector<HTMLImageElement>("[data-frame]");
      const label = root.querySelector("[data-label]");
      const count = root.querySelector("[data-count]");
      const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        const slide = slides[index];
        if (!slide || !frame) return;
        frame.src = slide.url;
        frame.alt = slide.label;
        if (label) label.textContent = slide.label;
        if (count) count.textContent = `${index + 1} / ${slides.length}`;
        dots.forEach((dot, i) => {
          dot.classList.toggle("bg-gold", i === index);
          dot.classList.toggle("bg-transparent", i !== index);
        });
      };
      root.querySelector("[data-prev]")?.addEventListener("click", () => show(index - 1));
      root.querySelector("[data-next]")?.addEventListener("click", () => show(index + 1));
      dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));
    });
  }
  bindCarousels();
  document.addEventListener("astro:page-load", bindCarousels);
</script>
