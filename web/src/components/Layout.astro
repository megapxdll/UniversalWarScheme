---
import "../styles/global.css";
import { sitePath } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Канон вселенной Universe War History — персонажи, миры, фракции и законы силы." } =
  Astro.props;
const pageTitle = title === "Universe War History" ? title : `${title} — Universe War History`;
const nav = [
  { href: sitePath("/characters"), label: "Персонажи" },
  { href: sitePath("/locations"), label: "Локации" },
  { href: sitePath("/factions"), label: "Фракции" },
  { href: sitePath("/rules"), label: "Правила" },
  { href: sitePath("/chronology"), label: "Хронология" },
  { href: sitePath("/events"), label: "События" },
  { href: sitePath("/graph"), label: "Граф" },
  { href: sitePath("/search"), label: "Поиск" },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-gold focus:px-3 focus:py-2 focus:text-void"
    >
      К содержанию
    </a>
    <header class="border-b border-line/80 bg-ink/70 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
        <a href={sitePath("/")} class="font-display text-2xl tracking-wide text-gold-soft">
          Universe War History
        </a>
        <details class="relative md:hidden">
          <summary class="cursor-pointer list-none rounded border border-line px-3 py-1.5 text-sm text-mist">
            Меню
          </summary>
          <nav class="absolute right-0 z-20 mt-2 min-w-48 rounded-lg border border-line bg-panel p-3 shadow-xl">
            <ul class="grid gap-2 text-sm">
              {nav.map((item) => (
                <li><a class="hover:text-gold" href={item.href}>{item.label}</a></li>
              ))}
              {import.meta.env.DEV && (
                <li><a class="hover:text-gold" href={sitePath("/admin")}>Админка</a></li>
              )}
            </ul>
          </nav>
        </details>
        <nav class="hidden items-center gap-5 text-sm text-mist md:flex">
          {nav.map((item) => (
            <a class="hover:text-gold" href={item.href}>{item.label}</a>
          ))}
          {import.meta.env.DEV && (
            <a class="hover:text-gold" href={sitePath("/admin")}>Админка</a>
          )}
        </nav>
      </div>
    </header>
    <main id="content" class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-line/80 py-8 text-center text-sm text-dim">
      Канон пишется в Obsidian и публикуется как энциклопедия. Черновики видны, пока не включён PUBLIC_HIDE_DRAFTS.
    </footer>
  </body>
</html>
