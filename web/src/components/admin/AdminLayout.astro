---
import "../../styles/global.css";
import { sitePath } from "../../lib/paths";

interface Props {
  title: string;
}

const { title } = Astro.props;
const pageTitle = `${title} — Админка канона`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-line/80 bg-ink/70 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
        <a href={sitePath("/admin")} class="font-display text-2xl tracking-wide text-gold-soft">Админка канона</a>
        <nav class="flex items-center gap-4 text-sm text-mist">
          <a class="hover:text-gold" href={sitePath("/admin/catalog")}>Справочники</a>
          <a class="hover:text-gold" href={sitePath("/admin")}>Создать</a>
          <a class="hover:text-gold" href={sitePath("/")}>Энциклопедия</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-line/80 py-8 text-center text-sm text-dim">
      Записи пишутся в папку Universe War History. Откройте vault в Obsidian — заметка и связи появятся сразу.
    </footer>
  </body>
</html>
