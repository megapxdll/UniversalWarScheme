---
import Layout from "../components/Layout.astro";
import { sitePath } from "../lib/paths";
---

<Layout title="Страница не найдена">
  <h1 class="font-display text-5xl text-gold-soft">Нет такой записи</h1>
  <p class="mt-4 text-dim">Этой страницы нет в каноне, либо она ещё черновик, скрытый при сборке.</p>
  <p class="mt-6">
    <a class="text-gold hover:text-gold-soft" href={sitePath("/")}>На главную</a>
  </p>
</Layout>
