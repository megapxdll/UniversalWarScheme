---
import Layout from "../../components/Layout.astro";
import MetaList from "../../components/MetaList.astro";
import WikiBody from "../../components/WikiBody.astro";
import PortraitCarousel from "../../components/PortraitCarousel.astro";
import StoryAppearances from "../../components/StoryAppearances.astro";
import StoryChip from "../../components/StoryChip.astro";
import CombatStats from "../../components/CombatStats.astro";
import CharacterAbilities from "../../components/CharacterAbilities.astro";
import {
  COLLECTIONS,
  collectionForType,
  getLore,
  isCollectionKey,
  TYPE_LABELS,
} from "../../lib/lore";
import { sitePath } from "../../lib/paths";
import { STORIES } from "../../lib/story-world";

export function getStaticPaths() {
  // Vault notes live outside src/; this re-runs in `astro dev` when the page module reloads.
  return getLore().entities.map((entity) => ({
    params: {
      collection: collectionForType(entity.type),
      slug: entity.slug,
    },
  }));
}

const { collection, slug } = Astro.params;
const lore = getLore();
const entity = lore.entities.find(
  (item) => item.slug === slug && isCollectionKey(collection) && collectionForType(item.type) === collection,
);

if (!entity) {
  return Astro.redirect(sitePath("/404"));
}

const mentionedIn = lore.incoming.get(entity.id) ?? [];
const collectionMeta = COLLECTIONS[collection];
---

<Layout title={entity.title} description={entity.excerpt || `${TYPE_LABELS[entity.type]} канона Universe War History.`}>
  <div class="flex flex-wrap gap-4 text-sm">
    <a href={sitePath(STORIES[entity.story].path)} class="text-gold hover:text-gold-soft">
      ← {STORIES[entity.story].kicker}
    </a>
    <a href={sitePath(`/${collection}`)} class="text-gold hover:text-gold-soft">← {collectionMeta.title}</a>
  </div>
  <div class="mt-4 flex flex-wrap items-start gap-6">
    {
      entity.type === "character" && entity.portraits.length > 0 && (
        <PortraitCarousel slides={entity.portraits} title={entity.title} />
      )
    }
    <div>
      <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.18em] text-dim">
        <span>{TYPE_LABELS[entity.type]}</span>
        <StoryChip world={entity.story} />
        {entity.status === "draft" && (
          <span class="rounded-full border border-gold/40 px-2 py-0.5 text-gold">Черновик</span>
        )}
      </div>
      <h1 class="mt-3 font-display text-5xl text-gold-soft">{entity.title}</h1>
      {
        entity.type === "character" &&
          [entity.extra.fioEn, entity.extra.heroNames, entity.extra.wikiTitle].some(
            (name) => name && name !== entity.title,
          ) && (
          <p class="mt-3 text-lg text-mist">
            {[entity.extra.fioEn, entity.extra.heroNames, entity.extra.wikiTitle]
              .filter((name) => name && name !== entity.title)
              .filter((name, index, list) => list.indexOf(name) === index)
              .join(" · ")}
          </p>
        )
      }
      {import.meta.env.DEV && (
        <a
          class="mt-3 inline-block text-sm text-gold hover:text-gold-soft"
          href={sitePath(`/admin/new?path=${encodeURIComponent(entity.sourcePath)}`)}
        >
          Править в админке
        </a>
      )}
    </div>
  </div>
  {
    entity.extra.portraitUrl && entity.type !== "character" && (
      <img
        src={entity.extra.portraitUrl}
        alt={entity.title}
        class="mt-6 w-full max-h-[34rem] rounded-2xl border border-line bg-ink object-contain"
      />
    )
  }

  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_16rem]">
    <article>
      <MetaList
        items={[
          { label: "ФИО", value: entity.extra.fioRu },
          { label: "ФИО (англ.)", value: entity.extra.fioEn },
          { label: "Наименование", value: entity.extra.heroNames },
          { label: "Пол", value: entity.extra.gender },
          { label: "Роль", value: entity.extra.role },
          { label: "Раса", value: entity.extra.race },
          { label: "Стихия", value: entity.extra.element },
          { label: "Цикл перерождений", value: entity.extra.cycle },
          { label: "Место рождения", value: entity.extra.home },
          { label: "Фракция", value: entity.extra.faction },
          { label: "Рост", value: entity.extra.height },
          { label: "Вес", value: entity.extra.weight },
          { label: "Тип волос", value: entity.extra.hairType },
          { label: "Цвет волос", value: entity.extra.hairColor },
          { label: "Цвет глаз", value: entity.extra.eyeColor },
          { label: "Телосложение", value: entity.extra.build },
          { label: "Вид", value: entity.extra.kind },
          { label: "Система", value: entity.extra.system },
          { label: "Население", value: entity.extra.population },
          { label: "Связанные персонажи", value: entity.extra.relatedCharacters },
          { label: "Цель", value: entity.extra.goal },
          { label: "Период существования", value: entity.extra.existencePeriod },
          { label: "Дата и время", value: entity.extra.eventDate },
          { label: "Место", value: entity.extra.eventPlace },
          { label: "Период", value: entity.extra.period },
          { label: "Эпоха", value: entity.extra.epoch },
          { label: "Диапазон", value: entity.extra.range },
          { label: "Участники", value: entity.extra.participants },
          { label: "Семья", value: entity.extra.family },
          { label: "Романтика", value: entity.extra.romance },
          { label: "Друзья", value: entity.extra.allies },
          { label: "Враги", value: entity.extra.enemies },
          { label: "Напарники", value: entity.extra.partners },
        ]}
      />
      {
        entity.type === "character" && (
          <CombatStats
            strength={entity.extra.strength}
            speed={entity.extra.speed}
            stamina={entity.extra.stamina}
            intellect={entity.extra.intellect}
            overall={entity.extra.overall}
            abilityType={entity.extra.abilityType}
            weapon={entity.extra.weapon}
            fightingStyle={entity.extra.fightingStyle}
          />
        )
      }
      {entity.type === "character" && <CharacterAbilities abilities={entity.abilities} />}
      <WikiBody entity={entity} />
      {entity.type === "character" && <StoryAppearances character={entity} />}
    </article>
    <aside class="h-fit rounded-2xl border border-line bg-panel/70 p-5">
      <h2 class="text-xs uppercase tracking-[0.18em] text-dim">Упоминается в</h2>
      {
        mentionedIn.length ? (
          <ul class="mt-3 space-y-2">
            {mentionedIn.map((item) => (
              <li>
                <a class="text-gold hover:text-gold-soft" href={item.href}>
                  {item.title}
                </a>
                <div class="text-xs text-dim">{TYPE_LABELS[item.type]}</div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 text-sm text-dim">Пока нет входящих ссылок.</p>
        )
      }
    </aside>
  </div>
</Layout>
