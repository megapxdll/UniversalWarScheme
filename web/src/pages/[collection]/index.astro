---
import Layout from "../../components/Layout.astro";
import EntityCard from "../../components/EntityCard.astro";
import { COLLECTIONS, entitiesOf, isCollectionKey } from "../../lib/lore";
import { sortEntitiesForCollection } from "../../lib/chronology";
import { sitePath } from "../../lib/paths";

export function getStaticPaths() {
  return (Object.keys(COLLECTIONS) as (keyof typeof COLLECTIONS)[]).map((collection) => ({
    params: { collection },
  }));
}

const { collection } = Astro.params;
if (!isCollectionKey(collection)) {
  return Astro.redirect(sitePath("/404"));
}

const meta = COLLECTIONS[collection];
const entities = sortEntitiesForCollection(entitiesOf(meta.type));
---

<Layout title={meta.title} description={`Канон: ${meta.title.toLowerCase()} вселенной Universe War History.`}>
  <p class="text-xs uppercase tracking-[0.28em] text-gold">Канон</p>
  <h1 class="mt-3 font-display text-5xl text-gold-soft">{meta.title}</h1>
  <p class="mt-4 max-w-2xl text-dim">
    {
      entities.length
        ? `${entities.length} ${meta.title.toLowerCase()} в текущем vault.`
        : "В vault пока нет записей этого типа. Шаблоны уже есть — страница появится, когда заметка попадёт в нужную папку."
    }
  </p>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {entities.map((entity) => <EntityCard entity={entity} />)}
  </div>
</Layout>
