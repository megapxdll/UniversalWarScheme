---
import Layout from "../components/Layout.astro";
import GraphCanvas from "../components/GraphCanvas.astro";
import { getLore } from "../lib/lore";

const lore = getLore();
const nodes = lore.entities.map((entity) => ({
  id: entity.id,
  title: entity.title,
  type: entity.type,
  href: entity.href,
}));
const edges = lore.edges.map((edge) => ({
  source: edge.source,
  target: edge.target,
}));
---

<Layout title="Граф канона" description="Связи персонажей, миров, фракций и правил Universe War History.">
  <p class="text-xs uppercase tracking-[0.28em] text-gold">Карта связей</p>
  <h1 class="mt-3 font-display text-5xl text-gold-soft">Граф канона</h1>
  <p class="mt-4 max-w-2xl text-dim">
    Узлы — записи vault, рёбра — вики-ссылки вроде [[Сакура]] и поля связей. Можно перетаскивать узлы.
  </p>
  <div class="mt-8">
    <GraphCanvas nodes={nodes} edges={edges} />
  </div>
</Layout>
